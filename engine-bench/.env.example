# Use the names you like, then pass them with --exit.
# Add these in Easypanel's Environment tab, or copy this file to .env for
# docker run --env-file .env. Never commit or zip a real .env file.
#
# Format: http://username:password@host:port (socks5:// also works)
PROXY_DATACENTER=
PROXY_RESIDENTIAL=
PROXY_IPV6=
